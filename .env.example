# Copy to .env and fill in. .env is gitignored.

# Reasoning model (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Web search, news and page scraping (https://serper.dev)
SERPER_API_KEY=
# Optional alternative provider
ANTHROPIC_API_KEY=

# gemini | anthropic | mock   (mock needs no key and runs offline)
FREYA_PROVIDER=gemini
FREYA_MODEL=gemini-3.1-flash-lite

# Optional overrides
#FREYA_DATA_DIR=~/.local/share/freya
#FREYA_PROJECTS_DIR=/path/to/your/projects
#FREYA_ADDRESS=
#FREYA_VERBOSE=1
